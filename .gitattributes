# Normalize line endings in the repository to LF.
# Windows working trees get CRLF on checkout; the index always stores LF.
* text=auto eol=lf

# Windows-only build scripts must keep CRLF to be executable by the shell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.exe binary
*.woff binary
*.woff2 binary
*.ttf binary
